# Copy to .env next to docker-compose.yml. Compose reads it automatically.

# Charter's control plane, and your key for it.
BOUNDFLOW_SERVER_ADDRESS=https://api.charter.dev:443
BOUNDFLOW_API_KEY=

# Your model provider's key. It is passed to the worker and used there; it does
# not reach the control plane.
ANTHROPIC_API_KEY=

# Where your worker.yaml and agent directories live, relative to this file.
CHARTER_PROJECT=../playground

# The shared store's password. Required — compose refuses to start without it.
#
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Where your Docker credentials live. Only needed when `serves:` pulls from a
# private registry — `docker login ghcr.io` writes it, and nothing else does.
DOCKER_CONFIG_DIR=~/.docker
